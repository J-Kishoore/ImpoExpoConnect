PORT=5000
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT session tokens
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Required to allow POST /api/admin/register — leave unset to disable
# admin self-registration entirely (seed the first admin via Firestore console instead).
ADMIN_INVITE_CODE=

# Base URL used when building links inside emails (password reset, email verification).
# Must be the publicly reachable frontend URL in production.
FRONTEND_URL=http://localhost:5173

# Email delivery via SMTP (Nodemailer). Leave SMTP_HOST unset to disable outgoing email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="ImpoExpo Connect <no-reply@yourdomain.com>"

# One-time link lifetimes
RESET_TOKEN_TTL=15m
VERIFICATION_TOKEN_TTL=10m

# Firebase Admin SDK credentials — from your Firebase service account JSON
# (Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
